{
  "name": "@qtsurfer/api-client",
  "version": "0.3.0",
  "description": "Auto-generated TypeScript API client for the QTSurfer API (from OpenAPI 3.1 spec)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "openapi-ts.config.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QTSurfer/api-client-ts.git"
  },
  "bugs": {
    "url": "https://github.com/QTSurfer/api-client-ts/issues"
  },
  "homepage": "https://github.com/QTSurfer/api-client-ts#readme",
  "author": "QTSurfer (https://github.com/QTSurfer)",
  "license": "Apache-2.0",
  "keywords": [
    "qtsurfer",
    "api-client",
    "typescript",
    "openapi",
    "hey-api",
    "backtesting",
    "trading"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.66",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
